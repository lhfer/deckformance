{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-cast.local/schemas/deck.schema.json",
  "title": "ppt-cast compiled deck",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "title", "releaseLevel", "compiledFrom", "fonts", "palette", "media", "slides"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "jobId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "releaseLevel": { "enum": ["candidate", "final"] },
    "compiledFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentPlan", "visualPlan", "assetManifest", "layouts"],
      "properties": {
        "contentPlan": { "$ref": "#/$defs/hash" },
        "visualPlan": { "$ref": "#/$defs/hash" },
        "assetManifest": { "$ref": "#/$defs/hash" },
        "layouts": { "$ref": "#/$defs/hash" }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "number"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "number": { "type": "string", "minLength": 1 }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg", "panel", "title", "body", "muted", "accent", "ink", "inkMuted"],
      "properties": {
        "bg": { "$ref": "#/$defs/color" },
        "panel": { "$ref": "#/$defs/color" },
        "title": { "$ref": "#/$defs/color" },
        "body": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "ink": { "$ref": "#/$defs/color" },
        "inkMuted": { "$ref": "#/$defs/color" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoVolume"],
      "properties": { "videoVolume": { "const": 0 } }
    },
    "slides": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layoutId", "kicker", "number", "title", "body", "speakerNotes", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "layoutId": {
            "enum": [
              "title-card",
              "cinematic-full",
              "split-left-video",
              "split-right-video",
              "character-stage-left",
              "character-stage-right",
              "top-video",
              "bottom-video",
              "center-cinema",
              "comparison-stage",
              "metric-video"
            ]
          },
          "kicker": { "type": "string" },
          "number": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
          "speakerNotes": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "items": { "type": "object" } },
          "poster": { "$ref": "#/$defs/path" },
          "video": { "$ref": "#/$defs/path" },
          "videoVolume": { "const": 0 }
        },
        "allOf": [
          {
            "if": { "properties": { "layoutId": { "const": "title-card" } }, "required": ["layoutId"] },
            "then": { "not": { "anyOf": [{ "required": ["poster"] }, { "required": ["video"] }, { "required": ["videoVolume"] }] } }
          },
          {
            "if": { "properties": { "layoutId": { "not": { "const": "title-card" } } }, "required": ["layoutId"] },
            "then": { "required": ["poster", "video", "videoVolume"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*$" },
    "color": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" }
  }
}
