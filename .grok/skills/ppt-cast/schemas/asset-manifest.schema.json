{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-cast.local/schemas/asset-manifest.schema.json",
  "title": "ppt-cast asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "upstreamHashes", "slides"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "jobId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "upstreamHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterModel", "contentPlan", "visualPlan"],
      "properties": {
        "characterModel": { "$ref": "#/$defs/hash" },
        "contentPlan": { "$ref": "#/$defs/hash" },
        "visualPlan": { "$ref": "#/$defs/hash" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "poster", "video", "attempts", "qa"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "poster": { "$ref": "#/$defs/png" },
          "video": { "$ref": "#/$defs/video" },
          "attempts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stills", "videos"],
            "properties": {
              "stills": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/attempt" }
              },
              "videos": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/attempt" }
              }
            }
          },
          "qa": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "binding", "frames", "slotComposite", "checks", "reviewedAt"],
            "properties": {
              "passed": { "const": true },
              "binding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["posterSha256", "videoSha256", "performanceBibleSha256", "visualPlanSha256"],
                "properties": {
                  "posterSha256": { "$ref": "#/$defs/hash" },
                  "videoSha256": { "$ref": "#/$defs/hash" },
                  "performanceBibleSha256": { "$ref": "#/$defs/hash" },
                  "visualPlanSha256": { "$ref": "#/$defs/hash" }
                }
              },
              "frames": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/png" },
                    {
                      "type": "object",
                      "required": ["timeRatio"],
                      "properties": { "timeRatio": { "type": "number", "minimum": 0, "maximum": 1 } }
                    }
                  ]
                }
              },
              "slotComposite": { "$ref": "#/$defs/png" },
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "identityConsistent",
                  "requiredBodyPartsVisible",
                  "limbCountStable",
                  "supportContactValid",
                  "actionInsideSafeCrop",
                  "occlusionContinuous",
                  "framingIntentional",
                  "noReadableText",
                  "slotCropSafe"
                ],
                "properties": {
                  "identityConsistent": { "const": true },
                  "requiredBodyPartsVisible": { "const": true },
                  "limbCountStable": { "const": true },
                  "supportContactValid": { "const": true },
                  "actionInsideSafeCrop": { "const": true },
                  "occlusionContinuous": { "const": true },
                  "framingIntentional": { "const": true },
                  "noReadableText": { "const": true },
                  "slotCropSafe": { "const": true }
                }
              },
              "reviewedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*$" },
    "assetBase": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "width", "height"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "png": {
      "allOf": [
        { "$ref": "#/$defs/assetBase" },
        {
          "type": "object",
          "required": ["mime"],
          "properties": { "mime": { "const": "image/png" } }
        }
      ]
    },
    "video": {
      "allOf": [
        { "$ref": "#/$defs/assetBase" },
        {
          "type": "object",
          "required": ["mime", "durationSeconds", "codec", "pixelFormat", "muted"],
          "properties": {
            "mime": { "const": "video/mp4" },
            "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "codec": { "const": "h264" },
            "pixelFormat": { "const": "yuv420p" },
            "muted": { "const": true }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "status", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "status": { "enum": ["selected", "rejected"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
