{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-cast.local/schemas/v2/visual-plan.schema.json",
  "title": "ppt-cast v2 visual plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planningStatus",
    "jobId",
    "upstreamHashes",
    "stylePack",
    "brandDirection",
    "registeredAssets",
    "slides"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "planningStatus": { "enum": ["draft", "approved"] },
    "jobId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "upstreamHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "characterModel", "contentPlan"],
      "properties": {
        "brief": { "$ref": "#/$defs/hash" },
        "characterModel": { "$ref": "#/$defs/hash" },
        "contentPlan": { "$ref": "#/$defs/hash" }
      }
    },
    "stylePack": { "enum": ["felt-yarn", "clay", "paper-cut", "cinematic-miniature"] },
    "brandDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deckPalette", "typography", "materials", "lighting", "motionLanguage"],
      "properties": {
        "deckPalette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bg", "panel", "title", "body", "muted", "accent", "ink", "inkMuted"],
          "properties": {
            "bg": { "$ref": "#/$defs/color" },
            "panel": { "$ref": "#/$defs/color" },
            "title": { "$ref": "#/$defs/color" },
            "body": { "$ref": "#/$defs/color" },
            "muted": { "$ref": "#/$defs/color" },
            "accent": { "$ref": "#/$defs/color" },
            "ink": { "$ref": "#/$defs/color" },
            "inkMuted": { "$ref": "#/$defs/color" }
          }
        },
        "typography": { "$ref": "https://ppt-cast.local/schemas/v2/typography.schema.json" },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "lighting": { "type": "string", "minLength": 1 },
        "motionLanguage": { "type": "string", "minLength": 1 }
      }
    },
    "registeredAssets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "slides": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/slide" }
    },
    "migration": { "$ref": "#/$defs/migration" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "color": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" },
    "pathOrNull": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^[^/\\\\][^\\\\]*$"
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "number", "minimum": 0, "maximum": 1 },
        "top": { "type": "number", "minimum": 0, "maximum": 1 },
        "right": { "type": "number", "minimum": 0, "maximum": 1 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "kind": { "enum": ["image", "logo", "uiScreenshot"] },
        "path": { "$ref": "#/$defs/pathOrNull" },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "widthPx", "heightPx"],
      "properties": {
        "aspect": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" },
        "widthPx": { "type": "integer", "minimum": 240, "maximum": 3840 },
        "heightPx": { "type": "integer", "minimum": 240, "maximum": 3840 }
      }
    },
    "motionPlan": {
      "description": "Video direction and playback intent supplied to an external video-generation model and the PPTX timing builder. It never synthesizes video bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "loopPolicy", "finalHoldSeconds", "beats"],
      "properties": {
        "durationSeconds": { "type": "number", "minimum": 3, "maximum": 10 },
        "loopPolicy": { "const": "hold-last-frame" },
        "finalHoldSeconds": { "type": "number", "minimum": 0, "maximum": 2 },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "action"],
            "properties": {
              "at": { "type": "number", "minimum": 0, "maximum": 10 },
              "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "targetLayerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "movement": { "enum": ["static", "push-in", "pull-out", "pan-left", "pan-right", "tilt-up", "tilt-down", "orbit-left", "orbit-right"] },
            "targetLayerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
            "gaze": { "type": "string", "minLength": 1 },
            "safeArea": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 },
                "width": { "type": "number", "minimum": 0, "maximum": 1 },
                "height": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "mediaBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps"],
      "properties": {
        "fps": { "enum": [24, 30] },
        "codec": { "const": "h264" },
        "pixelFormat": { "const": "yuv420p" },
        "muted": { "const": true },
        "maxBytes": { "const": 12582912 }
      }
    },
    "chartData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "categories", "series"],
      "properties": {
        "kind": { "enum": ["bar", "line", "area", "donut"] },
        "categories": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "values"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "values": { "type": "array", "minItems": 2, "items": { "type": "number" } }
            }
          }
        }
      }
    },
    "tableData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": { "type": ["string", "number", "null"] }
          }
        }
      }
    },
    "timelineData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "detail"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "processData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "detail"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "layerIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["video", "headline", "body", "metric", "quote", "chart", "table", "timeline", "process", "image", "logo", "uiScreenshot", "annotation"]
        },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "contentRef": { "enum": ["title", "body", "kicker", "takeaway"] },
        "styleToken": { "enum": ["display", "headline", "subhead", "body", "caption", "data", "number"] },
        "poster": { "$ref": "#/$defs/pathOrNull" },
        "video": { "$ref": "#/$defs/pathOrNull" },
        "slot": { "$ref": "#/$defs/slot" },
        "assetId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "text": { "type": "string", "minLength": 1 },
        "targetKey": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
        },
        "data": {}
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": { "required": ["slot"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["headline", "body"] } }, "required": ["type"] },
          "then": { "required": ["contentRef", "styleToken"] }
        },
        {
          "if": { "properties": { "type": { "const": "metric" } }, "required": ["type"] },
          "then": {
            "required": ["data", "sourceIds"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": ["string", "number"] },
                  "label": { "type": "string", "minLength": 1 },
                  "unit": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "quote" } }, "required": ["type"] },
          "then": {
            "required": ["data", "sourceIds"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "attribution"],
                "properties": {
                  "text": { "type": "string", "minLength": 1 },
                  "attribution": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "chart" } }, "required": ["type"] },
          "then": { "required": ["data", "sourceIds"], "properties": { "data": { "$ref": "#/$defs/chartData" } } }
        },
        {
          "if": { "properties": { "type": { "const": "table" } }, "required": ["type"] },
          "then": { "required": ["data", "sourceIds"], "properties": { "data": { "$ref": "#/$defs/tableData" } } }
        },
        {
          "if": { "properties": { "type": { "const": "timeline" } }, "required": ["type"] },
          "then": { "required": ["data", "sourceIds"], "properties": { "data": { "$ref": "#/$defs/timelineData" } } }
        },
        {
          "if": { "properties": { "type": { "const": "process" } }, "required": ["type"] },
          "then": { "required": ["data", "sourceIds"], "properties": { "data": { "$ref": "#/$defs/processData" } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["image", "logo", "uiScreenshot"] } }, "required": ["type"] },
          "then": { "required": ["assetId"] }
        },
        {
          "if": { "properties": { "type": { "const": "annotation" } }, "required": ["type"] },
          "then": { "required": ["text", "styleToken"] }
        }
      ]
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "composition", "mediaMode", "density", "negativeSpace", "visualProposition", "actionClass", "layerIntents", "motionPlan", "mediaBudget"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "composition": {
          "enum": [
            "auto",
            "cover-hero",
            "section-break",
            "hero-performance",
            "evidence-split",
            "metric-focus",
            "comparison",
            "timeline",
            "process",
            "quote-stage",
            "product-ui",
            "data-stage",
            "decision-close"
          ]
        },
        "mediaMode": { "enum": ["static-native", "hybrid-video"] },
        "density": { "enum": ["auto", "sparse", "balanced", "dense"] },
        "negativeSpace": { "enum": ["auto", "left", "right", "top", "bottom", "center", "none"] },
        "visualProposition": { "type": "string", "minLength": 1 },
        "actionClass": { "enum": ["locomotion", "jump", "landing", "push-pull", "large-prop", "upper-body-gesture", "idle", "other"] },
        "layerIntents": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/layerIntent" }
        },
        "motionPlan": { "anyOf": [{ "$ref": "#/$defs/motionPlan" }, { "type": "null" }] },
        "mediaBudget": { "anyOf": [{ "$ref": "#/$defs/mediaBudget" }, { "type": "null" }] }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromVersion", "needsDesignReplan", "warnings"],
      "properties": {
        "fromVersion": { "const": "1.0.0" },
        "needsDesignReplan": { "const": true },
        "warnings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
