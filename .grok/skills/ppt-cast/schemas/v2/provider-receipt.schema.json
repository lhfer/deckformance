{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-cast.local/schemas/v2/provider-receipt.schema.json",
  "title": "Deckformance external video generation provider receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptVersion", "kind", "producer", "runtime", "inputs", "outputs", "metadata", "createdAt", "receiptSha256"],
  "properties": {
    "receiptVersion": { "const": 1 },
    "kind": { "const": "provider" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementationSha256", "implementationFiles"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "implementationSha256": { "$ref": "#/$defs/hash" },
        "implementationFiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/descriptor" }
        }
      }
    },
    "runtime": { "type": "object", "minProperties": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/descriptor" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/descriptor" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "provider", "providerVersion", "providerClass", "adapterClass", "transport", "model", "operation", "promptSha256", "motionPlanSha256", "generationRequestSha256", "slideId", "layerId", "requestId", "durationMs", "cost", "outputMp4", "mediaContractValidated"],
      "properties": {
        "contractVersion": { "const": "deckformance.provider-video/1" },
        "provider": { "type": "string", "minLength": 1 },
        "providerVersion": { "type": "string", "minLength": 1 },
        "providerClass": { "const": "external-video-generation-model" },
        "adapterClass": { "type": "string", "minLength": 1 },
        "transport": { "enum": ["host", "http", "command", "api"] },
        "model": { "type": "string", "minLength": 1 },
        "operation": { "const": "generate-video" },
        "promptSha256": { "$ref": "#/$defs/hash" },
        "motionPlanSha256": { "$ref": "#/$defs/hash" },
        "generationRequestSha256": { "$ref": "#/$defs/hash" },
        "slideId": { "type": "string", "minLength": 1 },
        "layerId": { "type": "string", "minLength": 1 },
        "seed": {},
        "requestId": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number", "minimum": 0 },
        "cost": { "type": ["object", "null"] },
        "providerMetadata": {
          "type": "object",
          "properties": {
            "syntheticFixture": { "const": false },
            "liveProviderProof": { "const": true }
          },
          "additionalProperties": true
        },
        "outputMp4": { "$ref": "#/$defs/mp4Descriptor" },
        "mediaContractValidated": { "const": true },
        "mediaContract": { "type": "object" },
        "validation": { "type": "object" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "receiptSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*$" },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "mp4Descriptor": {
      "allOf": [
        { "$ref": "#/$defs/descriptor" },
        {
          "type": "object",
          "properties": {
            "path": { "type": "string", "pattern": "\\.[mM][pP]4$" }
          }
        }
      ]
    }
  }
}
