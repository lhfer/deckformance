{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-cast.local/schemas/v2/design-plan.schema.json",
  "title": "ppt-cast v2 resolved design plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "releaseEligibility", "jobId", "title", "compiledFrom", "stylePack", "registeredAssets", "slides"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "artifactKind": { "const": "design-plan" },
    "releaseEligibility": { "enum": ["draft-only", "candidate-ready"] },
    "jobId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "compiledFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "characterModel", "contentPlan", "visualPlan"],
      "properties": {
        "brief": { "$ref": "#/$defs/hash" },
        "characterModel": { "$ref": "#/$defs/hash" },
        "contentPlan": { "$ref": "#/$defs/hash" },
        "visualPlan": { "$ref": "#/$defs/hash" }
      }
    },
    "stylePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "implementationSha256", "materials", "compositionPreferences", "camera", "motion"],
      "properties": {
        "id": { "enum": ["felt-yarn", "clay", "paper-cut", "cinematic-miniature"] },
        "version": { "const": 1 },
        "implementationSha256": { "$ref": "#/$defs/hash" },
        "materials": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "compositionPreferences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "camera": { "type": "string", "minLength": 1 },
        "motion": { "type": "string", "minLength": 1 }
      }
    },
    "registeredAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "kind": { "enum": ["image", "logo", "uiScreenshot"] },
          "path": { "type": ["string", "null"], "minLength": 1 },
          "sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 10 },
        "y": { "type": "number", "minimum": 0, "maximum": 5.625 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 5.625 }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "widthPx", "heightPx"],
      "properties": {
        "aspect": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" },
        "widthPx": { "type": "integer", "minimum": 240, "maximum": 3840 },
        "heightPx": { "type": "integer", "minimum": 240, "maximum": 3840 }
      }
    },
    "resolvedStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "fontSize", "weight", "lineHeight", "letterSpacing"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 144 },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "lineHeight": { "type": "number", "minimum": 1, "maximum": 1.8 },
        "letterSpacing": { "type": "number", "minimum": -1, "maximum": 4 }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "z", "box"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "type": {
          "enum": ["video", "headline", "body", "metric", "quote", "chart", "table", "timeline", "process", "image", "logo", "uiScreenshot", "annotation"]
        },
        "z": { "type": "integer", "minimum": 0, "maximum": 999 },
        "box": { "$ref": "#/$defs/box" },
        "poster": { "type": ["string", "null"], "minLength": 1 },
        "video": { "type": ["string", "null"], "minLength": 1 },
        "mediaKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "slot": { "$ref": "#/$defs/slot" },
        "text": { "type": "string", "minLength": 1 },
        "styleToken": { "enum": ["display", "headline", "subhead", "body", "caption", "data", "number"] },
        "resolvedStyle": { "$ref": "#/$defs/resolvedStyle" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
        },
        "data": {},
        "assetId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "targetLayerId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": { "required": ["poster", "video", "mediaKey", "slot"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["headline", "body"] } }, "required": ["type"] },
          "then": { "required": ["text", "styleToken", "resolvedStyle"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["metric", "quote", "chart", "table", "timeline", "process"] } }, "required": ["type"] },
          "then": { "required": ["data", "sourceIds", "styleToken", "resolvedStyle"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["image", "logo", "uiScreenshot"] } }, "required": ["type"] },
          "then": { "required": ["assetId"] }
        },
        {
          "if": { "properties": { "type": { "const": "annotation" } }, "required": ["type"] },
          "then": { "required": ["text", "styleToken", "resolvedStyle", "targetLayerId"] }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "selected", "reason", "candidates", "rejected"],
      "properties": {
        "stage": { "enum": ["media-boundary", "density", "composition", "layer-resolution", "typography"] },
        "selected": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "candidates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rejected": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "textFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerId", "styleToken", "fontSize", "lineHeight", "letterSpacing", "lines", "estimatedWidthPt", "estimatedHeightPt", "box", "fit", "measurementMethod"],
      "properties": {
        "layerId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "styleToken": { "enum": ["display", "headline", "subhead", "body", "caption", "data", "number"] },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 144 },
        "lineHeight": { "type": "number", "minimum": 1, "maximum": 1.8 },
        "letterSpacing": { "type": "number", "minimum": -1, "maximum": 4 },
        "lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "estimatedWidthPt": { "type": "number", "minimum": 0 },
        "estimatedHeightPt": { "type": "number", "minimum": 0 },
        "box": { "$ref": "#/$defs/box" },
        "fit": { "const": true },
        "measurementMethod": { "enum": ["fontkit-xadvance-v1", "conservative-unicode-estimate-v1"] }
      }
    },
    "fontReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedFamily", "resolvedFamily", "fileName", "postscriptName", "sha256", "bytes", "resolver", "precision"],
      "properties": {
        "requestedFamily": { "type": "string", "minLength": 1 },
        "resolvedFamily": { "type": "string", "minLength": 1 },
        "fileName": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
        "postscriptName": { "type": ["string", "null"], "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1 },
        "resolver": { "const": "font-file-index-v1" },
        "precision": { "enum": ["fontkit", "conservative"] }
      }
    },
    "fontResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "measurementMethod", "tokens"],
      "properties": {
        "policy": { "const": "fail-closed" },
        "measurementMethod": { "enum": ["fontkit-xadvance-v1", "conservative-unicode-estimate-v1"] },
        "tokens": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/fontReceipt" }
        }
      }
    },
    "motionPlan": {
      "description": "Resolved video direction and playback intent. The external provider generates the MP4; this object never synthesizes media bytes.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "kind": { "const": "deckformance-motion-plan" },
        "targetLayerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "durationSeconds": { "type": "number", "minimum": 3, "maximum": 10 },
        "loopPolicy": { "const": "hold-last-frame" },
        "finalHoldSeconds": { "type": "number", "minimum": 0, "maximum": 2 },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "action", "targetLayerId"],
            "properties": {
              "at": { "type": "number", "minimum": 0, "maximum": 10 },
              "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "targetLayerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movement", "targetLayerId"],
          "properties": {
            "movement": { "enum": ["static", "push-in", "pull-out", "pan-left", "pan-right", "tilt-up", "tilt-down", "orbit-left", "orbit-right"] },
            "targetLayerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
            "gaze": { "type": "string", "minLength": 1 },
            "safeArea": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 },
                "width": { "type": "number", "minimum": 0, "maximum": 1 },
                "height": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        "playback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startTrigger", "startDelayMs", "playCount", "restart", "endBehavior", "advanceMode"],
          "properties": {
            "startTrigger": { "const": "on-slide-enter" },
            "startDelayMs": { "const": 0 },
            "playCount": { "const": 1 },
            "restart": { "const": "never" },
            "endBehavior": { "const": "hold-last-frame" },
            "advanceMode": { "const": "manual" }
          }
        },
        "planSha256": { "$ref": "#/$defs/hash" }
      }
      ,
      "required": ["schemaVersion", "kind", "targetLayerId", "durationSeconds", "loopPolicy", "finalHoldSeconds", "beats", "camera", "playback", "planSha256"]
    },
    "mediaBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "fps", "codec", "pixelFormat", "muted", "maxBytes"],
      "properties": {
        "durationSeconds": { "type": "number", "minimum": 3, "maximum": 10 },
        "fps": { "enum": [24, 30] },
        "codec": { "const": "h264" },
        "pixelFormat": { "const": "yuv420p" },
        "muted": { "const": true },
        "maxBytes": { "const": 12582912 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "url", "publisher", "retrievedAt", "isPrimary", "supports"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["user-material", "public-url", "inference"] },
        "url": { "type": ["string", "null"] },
        "publisher": { "type": ["string", "null"] },
        "retrievedAt": { "type": ["string", "null"] },
        "isPrimary": { "type": "boolean" },
        "supports": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "pageRole", "mediaMode", "compositionId", "density", "layers", "speakerNotes", "sources", "decisionTrace", "textFit", "fontResolution", "motionPlan"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "enum": ["cover", "section", "content", "closing"] },
        "pageRole": { "enum": ["cover", "section", "hero", "evidence", "metric", "comparison", "timeline", "process", "quote", "product-ui", "chart", "table", "decision", "closing"] },
        "mediaMode": { "enum": ["static-native", "hybrid-video"] },
        "compositionId": { "type": "string", "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)?$" },
        "density": { "enum": ["sparse", "balanced", "dense"] },
        "layers": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "$ref": "#/$defs/layer" } },
        "speakerNotes": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "decisionTrace": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/decision" } },
        "textFit": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/textFit" } },
        "fontResolution": { "$ref": "#/$defs/fontResolution" },
        "motionPlan": { "$ref": "#/$defs/motionPlan" },
        "mediaBudget": { "$ref": "#/$defs/mediaBudget" }
      },
      "allOf": [
        {
          "if": { "properties": { "mediaMode": { "const": "hybrid-video" } }, "required": ["mediaMode"] },
          "then": {
            "required": ["mediaBudget"],
            "properties": {
              "layers": {
                "contains": { "type": "object", "properties": { "type": { "const": "video" } }, "required": ["type"] },
                "minContains": 1,
                "maxContains": 1
              },
              "motionPlan": { "type": "object" }
            }
          }
        },
        {
          "if": { "properties": { "mediaMode": { "const": "static-native" } }, "required": ["mediaMode"] },
          "then": {
            "not": { "required": ["mediaBudget"] },
            "properties": {
              "layers": {
                "not": {
                  "contains": { "type": "object", "properties": { "type": { "const": "video" } }, "required": ["type"] }
                }
              },
              "motionPlan": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
