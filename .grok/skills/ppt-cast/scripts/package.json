{
  "name": "ppt-cast-scripts",
  "version": "2.0.0",
  "private": true,
  "description": "Deck builder for the ppt-cast skill",
  "engines": {
    "node": ">=20 <21 || >=22 <23"
  },
  "bin": {
    "deckformance-benchmark-report": "benchmark_report.js",
    "deckformance-blind-test": "blind_test.js",
    "deckformance-build-v2": "build_deck_v2.js",
    "deckformance-compile-deck-v2": "compile_deck_v2.js",
    "deckformance-compile-design": "compile_design.js",
    "deckformance-doctor": "doctor.js",
    "deckformance-distribute": "generate_distributions.js",
    "deckformance-gallery": "build_gallery.js",
    "deckformance-jobctl-v2": "jobctl_v2.js",
    "deckformance-migrate-v1": "migrate_v1.js",
    "deckformance-preflight": "preflight.js",
    "deckformance-preview-design-v2": "preview_design_v2.js",
    "deckformance-validate-v2": "validate_pptx_v2.js"
  },
  "scripts": {
    "test": "node --test ../tests/state_contracts.test.js ../../../../tests/build*.test.js",
    "test:runtime": "node --test ../../../../tests/build_runtime_portability.test.js",
    "coverage": "node coverage_gate.js",
    "benchmark": "node benchmark_report.js",
    "blind": "node blind_test.js",
    "build:v2": "node build_deck_v2.js",
    "compile:deck:v2": "node compile_deck_v2.js",
    "compile:design": "node compile_design.js",
    "doctor": "node doctor.js --json --release candidate",
    "distribute": "node generate_distributions.js",
    "gallery": "node build_gallery.js",
    "jobctl:v2": "node jobctl_v2.js",
    "preflight": "node preflight.js",
    "preview:design:v2": "node preview_design_v2.js",
    "validate:v2": "node validate_pptx_v2.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fontkit": "2.0.4",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "c8": "12.0.0"
  }
}
